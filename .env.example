# Local server (bound to 127.0.0.1 only)
PORT=9000
DATABASE_PATH=./data/app.db

# AI provider keys — optional. Paste them in Settings → AI instead; a key saved
# there takes precedence over the one here. Never exposed to the browser.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
QWEN_API_KEY=
# Mainland China Qwen accounts: QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
